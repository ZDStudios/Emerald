{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome",
  "description": "Emerald's own UI. Scoped to the `chrome` webview by label and to local origins only — deliberately NOT via `windows: [\"main\"]`, because a window-scoped capability applies to every webview in that window, which would hand all of this to every web page Emerald renders.",
  "local": true,
  "webviews": ["chrome"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:event:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",

    "allow-get-state",
    "allow-set-settings",
    "allow-reset-settings",
    "allow-open-tab",
    "allow-activate-tab",
    "allow-close-tab",
    "allow-discard-tab",
    "allow-archive-tab",
    "allow-navigate-tab",
    "allow-reload-tab",
    "allow-history-back",
    "allow-history-forward",
    "allow-set-pinned",
    "allow-reorder-tab",
    "allow-set-insets",
    "allow-set-panes",
    "allow-set-overlay",
    "allow-split-with",
    "allow-unsplit",
    "allow-toggle-reader",
    "allow-set-zoom",
    "allow-add-space",
    "allow-remove-space",
    "allow-switch-space",
    "allow-add-bookmark",
    "allow-remove-bookmark",
    "allow-clear-history",
    "allow-search-all",
    "allow-resolve-query",
    "allow-memory-sample",
    "allow-list-extensions",
    "allow-install-extension",
    "allow-install-from-store",
    "allow-check-for-update",
    "allow-download-update",
    "allow-set-extension-enabled",
    "allow-remove-extension",
    "allow-recent-drafts",
    "allow-discard-all-idle"
  ]
}
