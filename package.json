{
  "name": "emerald-browser",
  "version": "0.1.1",
  "description": "Emerald — a calm, low-footprint web browser",
  "license": "MPL-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "schema": "cd src-tauri && cargo run --quiet --bin gen-schema",
    "bench": "./bench/run.sh",
    "check": "tsc --noEmit && cd src-tauri && cargo clippy --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
